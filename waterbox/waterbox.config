        "min": -127,
        "max": 127,
        "neutral": 0
      }
    ]
  },
  "settings": [
    {
      "name": "ipl_rom",
      "display": "IPL-ROM",
      "type": "enum",
      "options": [
        "ipl10",
        "ipl11",
        "ipl12",
        "ipl13",
        "cz600ce"
      ],
      "default": "ipl10",
      "description": "Which IPL-ROM (the X68000's BIOS) the machine boots: ipl10 = IPL-ROM V1.0 (87/05/07); ipl11 = IPL-ROM V1.1 (91/01/11), the X68000 XVI's; ipl12 = IPL-ROM V1.2 (91/10/24), the X68000 Compact's; ipl13 = IPL-ROM V1.3 (92/11/27), the X68030's; cz600ce = CZ-600CE IPL-ROM V1.0 (87/03/18), the first X68000's two chips. Each is its own firmware file. MAME's own default is cz600ce; this core's is ipl10, the ROM most collections carry as iplrom.dat. Part of the machine: a movie needs the same one."
    },
    {
      "name": "ram",
      "display": "RAM",
      "type": "enum",
      "options": [
        "1M",
        "2M",
        "3M",
        "4M",
        "5M",
        "6M",
        "7M",
        "8M",
        "9M",
        "10M",
        "11M",
        "12M"
      ],
      "default": "4M",
      "description": "The main memory, 1 to 12 MB. An X68000 shipped with 1 or 2 MB; MAME's default, and this core's, is 4 MB, which most software is happy with. Part of the machine: a movie needs the same size."
    },
    {
      "name": "clock",
      "display": "Clock at power-on",
      "type": "string",
      "default": "2000-01-01 00:00:00",
      "description": "The RP5C15 clock's date and time at power-on, as YYYY-MM-DD HH:MM:SS, from 1980 to 2079. It runs with the machine from there, never with the host's clock. Human68k stamps files with it and some programs seed their random numbers from it, so it is part of the machine: a movie needs the same one."
    }
  ],
  "firmware": [
    {
      "id": "cgrom.dat",
      "display": "Character generator ROM (cgrom.dat)",
      "description": "The X68000's 768 KB font ROM: the kanji, kana and ASCII glyphs every model draws its text with. Sharp's, and yours to supply; the same file serves every IPL-ROM.",
      "name": "cgrom.dat",
      "size": 786432,
      "sha1": "8d72c5b4d63bb14c5dbdac495244d659aa1498b6"
    },
    {
      "id": "iplrom.dat",
